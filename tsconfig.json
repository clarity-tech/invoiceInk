{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        // "types" is explicit, so anything omitted here is invisible to
        // vue-tsc. Without "vitest/globals" the globals enabled by
        // `test.globals` in vitest.config.ts -- vi, describe, afterEach --
        // are unknown, and without "node" so are require and global.
        "types": ["vite/client", "vitest/globals", "node"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts", "resources/js/**/*.vue"],
    "exclude": ["node_modules"]
}
