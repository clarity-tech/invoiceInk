APP_NAME=InvoiceInk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Email branding (see config/branding.php)
BRAND_COLOR="#7c3aed"
BRAND_TAGLINE="Smart Invoicing for Modern Businesses"
BRAND_SLOGAN="Invoices that get paid faster."
# Email logo strategy. true (default) = hosted-URL lockup image, false = inline CID icon + HTML text
BRAND_LOGO_EXTERNAL=true
# Optional absolute URL override for the external logo (e.g. a CDN host).
# BRAND_LOGO_URL=
# Append an attribution tag to every email subject ("... - Sent Using InvoiceInk").
# Set to false for fully white-labelled subject lines.
BRAND_SUBJECT_TAG=true
# BRAND_SUBJECT_TAG_TEXT="Sent Using InvoiceInk"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single

# Mirrors errors and exceptions into a Google Chat space. Off unless enabled,
# and silent when no webhook is set, so local and CI need none of this.
# Production sets ENABLED=true, stacks the channel onto stderr, and supplies
# the webhook from Secret Manager.
LOG_GOOGLE_CHAT_ENABLED=false
LOG_GOOGLE_CHAT_WEBHOOK_URL=
LOG_GOOGLE_CHAT_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@clarity.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage — uses RustFS (S3-compatible) for local, S3/Spaces for production
FILESYSTEM_DISK=s3

# RustFS S3-compatible storage (local development via Sail)
# In production, replace with actual S3/DigitalOcean Spaces credentials
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=http://localhost:9000/local
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false

# Gotenberg PDF service (https://gotenberg.dev)
FORWARD_GOTENBERG_PORT=3000
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=30
GOTENBERG_ENABLED=true

# MCP server
# The HTTP endpoint at POST /mcp is OFF unless this is true, so deploying the
# server does not expose it. Safe as a runtime condition because route:cache runs
# at container start, not build time. Enable per environment when you intend to
# serve it; clients then authenticate with "Authorization: Bearer <api-token>".
# MCP_WEB_ENABLED=true
#
# The local (stdio) server has no HTTP request to carry an API token, so it must
# be told which user to act as. Leave unset and every tool fails closed rather
# than reading data it cannot attribute to an organization. Ignored in
# production, where the token-authenticated /mcp endpoint is the only way in.
# MCP_LOCAL_USER_EMAIL=you@example.test

# Uncomment the following lines to enable Xdebug in Laravel Sail
# SAIL_XDEBUG_MODE=develop,debug,coverage

# Octane Configuration
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500
OCTANE_MEMORY_LIMIT=256
OCTANE_WATCH=false
