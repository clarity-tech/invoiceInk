# Production Dockerfile: ServerSideUp FrankenPHP + Laravel Octane
# Multi-stage build: PHP deps → Frontend → Final image
#
# Docs:
#   ServerSideUp PHP:   https://serversideup.net/open-source/docker-php/
#   ServerSideUp Octane: https://serversideup.net/open-source/docker-php/docs/framework-guides/laravel/octane
#   FrankenPHP Docker:  https://frankenphp.dev/docs/docker/
#   Laravel Octane:     https://laravel.com/docs/octane

# ========================================
# Stage 1: PHP Dependencies
# ========================================
FROM serversideup/php:8.5-cli AS php-deps

USER root
WORKDIR /var/www/html

# Install extensions required by composer platform checks
RUN install-php-extensions exif gd intl bcmath sockets

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-ansi \
    --no-scripts \
    --optimize-autoloader

# Pre-generate Wayfinder TypeScript files here, where PHP is available.
# The frontend (Bun) stage has no PHP, so the Vite plugin can't run wayfinder:generate.
COPY . .

RUN mkdir -p bootstrap/cache \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
    && APP_ENV=production \
       APP_DEBUG=false \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       php artisan wayfinder:generate --with-form

# ========================================
# Stage 2: Frontend Build (Bun)
# ========================================
FROM oven/bun:1 AS frontend

WORKDIR /build

# Copy app source + vendor + pre-generated Wayfinder TS files from php-deps
COPY --from=php-deps --chown=www-data:www-data /var/www/html /build

RUN bun install --frozen-lockfile

RUN mkdir -p storage/framework/views

# Skip the Wayfinder Vite plugin (no PHP here; files were pre-generated above)
ENV WAYFINDER_SKIP_GENERATE=1
ARG VITE_APP_NAME="InvoiceInk"
RUN bun run build

# ========================================
# Stage 3: Production (ServerSideUp FrankenPHP + Octane)
# ========================================
# ServerSideUp provides: non-root user (www-data), S6 overlay, composer,
# pre-installed extensions (opcache, pcntl, redis, zip),
# Laravel autorun (migrate, optimize, storage:link), health check scripts.
# See: https://serversideup.net/open-source/docker-php/docs/image-variations/frankenphp
FROM serversideup/php:8.5-frankenphp AS production

# Install additional PHP extensions not included in base image
USER root
RUN install-php-extensions pdo_mysql exif gd intl bcmath sockets
USER www-data

WORKDIR /var/www/html

# Copy production PHP configuration
COPY --chown=www-data:www-data docker/production/php.ini /usr/local/etc/php/conf.d/99-production.ini

# Copy application code, vendor deps, and built assets
COPY --from=frontend --chown=www-data:www-data /build /var/www/html

# Rebuild autoload classmap with full app code, bake the env-independent caches,
# then clean up in a single layer.
#
# view:cache compiles Blade templates and event:cache scans listener classes —
# neither depends on the environment, so baking them removes that work from
# every cold start.
#
# route:cache is deliberately NOT baked. Route registration can be conditional
# on runtime config: the Cloud Tasks package only registers POST /handle-task
# when cloud-tasks.disable_task_handler is false. Baking the cache would freeze
# in the build-time answer, and Laravel loads the compiled routes instead of
# re-evaluating that condition — putting the task handler on the public service
# regardless of its environment.
#
# config:cache is likewise not baked; it would freeze build-time env.
ARG BUILD_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev \
    && APP_ENV=production APP_DEBUG=false APP_KEY=${BUILD_APP_KEY} \
       php artisan view:cache \
    && APP_ENV=production APP_DEBUG=false APP_KEY=${BUILD_APP_KEY} \
       php artisan event:cache \
    && rm -rf docker resources/css resources/js \
        vite.config.ts tsconfig.json eslint.config.js .prettierrc \
        package.json bun.lock

# ServerSideUp Laravel automations (runs on container start).
# See: https://serversideup.net/open-source/docker-php/docs/framework-guides/laravel/automations
#
# Migrations are disabled by default because on Cloud Run every scale-from-zero
# would re-run them, and a traffic burst starts several instances at once. They
# run instead as a dedicated Cloud Run Job before any new revision serves traffic.
# Single-container deployments (the VPS) can safely set
# AUTORUN_LARAVEL_MIGRATION=true back in their own env file.
#
# view/event caches are baked into the image above and switched off here.
# config:cache and route:cache are off too: Octane boots each worker once, so
# at container start they only added ~4s to every cold start.
ENV AUTORUN_ENABLED=true \
    AUTORUN_LARAVEL_MIGRATION=false \
    AUTORUN_LARAVEL_MIGRATION_ISOLATION=true \
    AUTORUN_LARAVEL_OPTIMIZE=false \
    AUTORUN_LARAVEL_CONFIG_CACHE=false \
    AUTORUN_LARAVEL_ROUTE_CACHE=false \
    AUTORUN_LARAVEL_VIEW_CACHE=false \
    AUTORUN_LARAVEL_EVENT_CACHE=false \
    AUTORUN_LARAVEL_STORAGE_LINK=false \
    PHP_OPCACHE_ENABLE=1 \
    SSL_MODE=off \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    OCTANE_WORKERS=4 \
    OCTANE_MAX_REQUESTS=500

EXPOSE 8080

# ServerSideUp provides healthcheck-octane script out of the box
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["healthcheck-octane"]

# Shell form so the platform-injected $PORT is honoured (Cloud Run's container
# contract). Workers are explicit rather than "auto" so the count does not drift
# with the CPU limit of whatever host this runs on.
CMD ["sh", "-c", "php artisan octane:start --server=frankenphp --host=0.0.0.0 --port=${PORT:-8080} --workers=${OCTANE_WORKERS:-4} --max-requests=${OCTANE_MAX_REQUESTS:-500}"]
